<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_slot_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    tools:ignore="TouchTargetSizeCheck"> <!-- Chấm trạng thái -->
    <View
        android:id="@+id/view_status"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/circle_available" /> <!-- Thời gian -->
    <TextView
        android:id="@+id/tv_slot_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="08:00 - 09:00"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold" /> <!-- Icon check nếu slot được chọn -->
    <ImageView
        android:id="@+id/img_selected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check"
        android:visibility="gone" />
</LinearLayout>